# =============================================================
# Variables d'environnement — Soirée Célibataires
# Copiez ce fichier en .env et remplissez les valeurs
# NE JAMAIS committer le fichier .env avec de vraies valeurs
# =============================================================

# Secret administrateur — protège toutes les routes /api/admin/*
# Générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET=REMPLACER_PAR_UN_SECRET_FORT_ET_ALEATOIRE

# Port du serveur local (Vercel ignore cette variable)
PORT=3001

# NODE_ENV — 'production' sur Vercel, 'development' en local
NODE_ENV=development
